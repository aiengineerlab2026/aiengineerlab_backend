# Copy to backend/.env and fill in. Never commit the real file.

# --- app -------------------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=*   # all origins; or a comma-separated list, e.g. http://localhost:3000,https://app.example.com

# --- database (Supabase PostgreSQL + pgvector) -----------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Direct connection (needs IPv6):
#   postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# Session pooler (works on IPv4-only networks; recommended if the direct host doesn't resolve):
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# If the password contains special characters (@ : / # ? %) percent-encode them, e.g. "@" -> "%40".
# The postgresql:// scheme is rewritten to postgresql+asyncpg:// automatically.
# Do NOT use the transaction pooler (port 6543) for Alembic migrations.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# Local alternative (docker compose up -d db):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag_lab
DB_SSL=auto            # auto = TLS for remote hosts, off for localhost
DB_POOL_SIZE=5

# --- LLM (needed for: LLM chat parsing, grounded answers, multi-query, live-evaluation relevance judge) --
# provider "openai" works with ANY OpenAI-compatible endpoint (set LLM_BASE_URL);
# provider "google" uses Gemini via langchain-google-genai.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Examples:
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:  LLM_PROVIDER=google  LLM_MODEL=gemini-2.0-flash   (or the OpenAI-compat URL
#            https://generativelanguage.googleapis.com/v1beta/openai/ with provider openai)
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1   (key may stay empty)
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Gemini through LangChain (langchain-google-genai) - what this project is configured for:
#   LLM_PROVIDER=google  LLM_MODEL=gemini-2.5-flash  LLM_API_KEY=<your Google AI Studio key>

# --- abuse protection ----------------------------------------------------------------------
# Chat messages (each can trigger LLM calls) allowed per client IP address within the window. 0 disables.
CHAT_RATE_LIMIT_MAX=5
CHAT_RATE_LIMIT_WINDOW_SECONDS=2592000
# Evaluations (Evaluate button; judge LLM + LLM-based RAGAS, ~a dozen model calls per question) one client IP may run. 0 disables.
EVAL_RATE_LIMIT_MAX=2
EVAL_RATE_LIMIT_WINDOW_SECONDS=86400
# Behind a reverse proxy only: read the client IP from X-Forwarded-For (clients can spoof it otherwise).
TRUST_PROXY_HEADERS=false

# --- embeddings ----------------------------------------------------------------------------
# Gemini through LangChain (gemini-embedding-001 is truncated to 384 dims and L2-normalised); uses LLM_API_KEY.
# EMBEDDING_DIMENSIONS must match the pgvector column created by the Alembic migration (384).
# The Configuration tab offers two embedding models: gemini-embedding-001 (above) and Cloudflare @cf/baai/bge-m3 (1024-d,
# stored in its own vector column). The menu is indexed with both ahead of time, so switching just points to the ready index.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=384
EMBEDDING_VERSION=1
# Only for provider openai/google; fall back to LLM_API_KEY / LLM_BASE_URL when empty.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Cloudflare Workers AI (optional) -------------------------------------------------------
# Adds Cloudflare models (chat, evaluation judge, embeddings) to the pickers in the Configuration tab.
# Used through LangChain's OpenAI-compatible client. The token is a SECRET: put the real value only in backend/.env.
# Token: Cloudflare dashboard -> AI -> Workers AI -> "Use REST API" -> Create a Workers AI API token.
# Account id: the long hex string in the dashboard URL (dash.cloudflare.com/<ACCOUNT_ID>/...).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- evaluation ----------------------------------------------------------------------------
EVAL_LLM_PROVIDER=      # defaults to LLM_PROVIDER
EVAL_LLM_MODEL=         # defaults to LLM_MODEL
EVAL_MAX_WORKERS=4
EVAL_TIMEOUT_SECONDS=300
# Automatically score real chat questions (LLM-judged relevance + LLM-free RAGAS).
# Costs one extra judge-LLM call per search question; set false to disable.
LIVE_EVALUATION_ENABLED=true

# --- background worker ---------------------------------------------------------------------
# true  = jobs (indexing, evaluation) run inside the API process.
# false = run `python -m app.worker` separately.
RUN_WORKER=true
WORKER_POLL_SECONDS=2
